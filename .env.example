# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini API キー（★サーバー専用★・クライアントには絶対に露出させない）
# Vercel のプロジェクト設定 → Environment Variables に「GEMINI_API_KEY」として登録する。
# EXPO_PUBLIC_ を付けない＝ブラウザのJSに埋め込まれない。api/gemini.js から参照される。
# 注意: 旧 EXPO_PUBLIC_GEMINI_API_KEY はバンドルに露出するため廃止（不正使用の原因）。
GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics 4 (任意・アクセス解析用。GA4の測定ID G-XXXXXXXXXX)
EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
